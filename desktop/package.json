{
  "name": "echo-desktop",
  "productName": "Echo",
  "version": "1.0.0",
  "description": "Echo para computador: ligações, transmissão de tela e o som do computador junto.",
  "main": "src/main.js",
  "author": "Ana Clara Alcantara",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "dev.workers.echo-ac-2k4.echo",
    "productName": "Echo",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["src/**/*", "package.json"],
    "artifactName": "Echo-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.social-networking",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O Echo usa o microfone nas ligações.",
        "NSCameraUsageDescription": "O Echo não usa a câmera, mas o macOS pede esta frase para compartilhar a tela.",
        "NSScreenCaptureUsageDescription": "O Echo transmite a tela que você escolher."
      }
    },
    "dmg": { "title": "Echo" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": true, "perMachine": false, "shortcutName": "Echo", "createDesktopShortcut": true }
  }
}
